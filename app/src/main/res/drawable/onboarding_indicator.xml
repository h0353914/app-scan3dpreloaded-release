<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:dither="true" android:shape="oval" android:useLevel="true">
            <size android:height="@dimen/pager_icon_size" android:width="@dimen/pager_icon_size" />
            <solid android:color="@android:color/black" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:dither="true" android:shape="oval" android:useLevel="true">
            <size android:height="@dimen/pager_icon_size" android:width="@dimen/pager_icon_size" />
            <solid android:color="@color/onboarding_indicator_not_selected" />
        </shape>
    </item>
</selector>
