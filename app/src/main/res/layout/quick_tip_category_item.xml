<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/wizard_card_margin" android:elevation="@dimen/standard_elevation"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:padding="@dimen/wizard_item_padding" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toStartOf="@id/image" android:layout_alignParentStart="true">
        <TextView android:id="@id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/QuickTipItem.Subtitle" />
        <LinearLayout android:orientation="vertical" android:id="@id/layout_expanded" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <TextView android:id="@id/description" android:layout_width="fill_parent" android:layout_height="wrap_content" style="@style/QuickTipItem.Description" />
            <TextView android:textColor="@android:color/white" android:layout_gravity="start" android:id="@id/show_me" android:background="@null" android:clickable="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/quick_tip_category_item_button_margin_top" android:minWidth="0.0dip" android:text="@string/wizard_card_button_show_me" style="?android:borderlessButtonStyle" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@id/image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
</RelativeLayout>
