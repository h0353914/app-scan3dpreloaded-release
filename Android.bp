// app-scan3d (3D Creator, com.sonymobile.scan3d) 3.0.A.0.36 手刻版原始碼建置。
// 取代原本 android_app_import 直接掛 proprietary blob apk 的做法：來源見
// apps/app-scan3d/ submodule（java-3.0.A.0.36-a15 分支），跟 CameraPanorama 同一種
// 「apps/<name> 子模組 + 本地 Android.bp 直接編原始碼」模式。
//
// static_libs 清單裡 111 個 app_scan3d_dep_* 模組是從 app/build.gradle.kts 用
// `./gradlew :app:dependencies --configuration releaseRuntimeClasspath` 解析出的
// 完整遞移依賴（不只是直接宣告的 ~60 個座標），逐一從 Gradle cache 複製對應的
// .aar/.jar 到 app/libs/vendored/ 底下、用 java_import/android_library_import 匯入
// （Soong 沒有 Maven 依賴解析，必須把整條遞移鏈都攤平列出來，否則編譯期會缺 class）。
//
// libScan3D.so 是未經二進位修改的原始版本（3.0.A.0.36 隨機版）。原本因為
// ro.com.google.clientidbase device-property 檢查沒過，一度靠 NOP-patch 過
// 的版本繞過；device/sony/poplardcm/lineage_poplardcm.mk 把
// PRODUCT_GMS_CLIENTID_BASE 改成 android-sonymobile 修掉 root cause 之後，
// 實機驗證這個原始版本可以正常執行到相機掃描介面，不用再靠二進位修改。

cc_prebuilt_library_shared {
    name: "app_scan3d_libgifimage",
    stem: "libgifimage",
    compile_multilib: "64",
    target: {
        android_arm64: {
            srcs: ["app/src/main/jniLibs/arm64-v8a/libgifimage.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "app_scan3d_libimagepipeline",
    stem: "libimagepipeline",
    compile_multilib: "64",
    target: {
        android_arm64: {
            srcs: ["app/src/main/jniLibs/arm64-v8a/libimagepipeline.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "app_scan3d_libitseez3d_animation",
    stem: "libitseez3d_animation",
    compile_multilib: "64",
    target: {
        android_arm64: {
            srcs: ["app/src/main/jniLibs/arm64-v8a/libitseez3d_animation.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "app_scan3d_libScan3D",
    stem: "libScan3D",
    compile_multilib: "64",
    target: {
        android_arm64: {
            srcs: ["app/src/main/jniLibs/arm64-v8a/libScan3D.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

