        <ImageView android:id="@id/left_image" android:layout_width="0.0px" android:layout_height="fill_parent" android:scaleType="fitCenter" android:layout_weight="1.0" />
        <ImageView android:id="@id/right_image" android:layout_width="0.0px" android:layout_height="fill_parent" android:scaleType="fitCenter" android:layout_weight="1.0" />
    </LinearLayout>
