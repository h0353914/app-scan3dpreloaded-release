<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="@color/fullscreen_primary_color_bg" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:layout_gravity="top" android:layout_width="fill_parent" android:layout_height="wrap_content" android:src="@drawable/signin_background" android:scaleType="centerInside" />
    <ScrollView android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:paddingBottom="@dimen/sign_in_scrollview_padding_bottom" android:layout_width="fill_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/sign_in_padding" android:paddingEnd="@dimen/sign_in_padding">
            <TextView android:id="@id/title_text" style="@style/AuthenticationText.Title" />
            <TextView android:id="@id/description_text" style="@style/AuthenticationText.Description" />
            <TextView android:id="@id/disclaimer_text" style="@style/AuthenticationText.Description" />
            <Button android:textColor="@android:color/black" android:layout_gravity="center_horizontal" android:id="@id/button_ok" android:padding="10.0dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/sign_in_margin_top" android:minWidth="@dimen/personal_data_button_min_width" android:text="@string/privacy_agree" android:backgroundTint="@android:color/white" />
            <Button android:textColor="@android:color/black" android:layout_gravity="center_horizontal" android:id="@id/button_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sign_in_screen_not_now_button" style="@android:style/Widget.Material.Button.Borderless" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
